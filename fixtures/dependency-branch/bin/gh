#!/usr/bin/env bash
# A stand-in for gh, for test.sh. Reads answer from canned JSON in $FAKE_GH_DIR, in the shape
# `gh pr list --json` gives (the script's GraphQL query is answered from it), and appends every
# write to $FAKE_GH_DIR/writes.log, one line per call, the --body value dropped. A --body value is
# appended to $FAKE_GH_DIR/bodies.log, after a `== <the writes.log line>` header.
set -euo pipefail

dir=${FAKE_GH_DIR:?FAKE_GH_DIR is not set}
args="$*"

case "$1 $2" in
  "api graphql")
    # Open PRs, from the canned gh-shaped JSON turned into the GraphQL answer.
    if [[ $args == *checkSuite* ]]; then
      echo "fake gh: the query asks for checkSuite, which needs Actions: read" >&2
      exit 1
    elif [[ $args == *" head="* ]]; then
      file=$dir/promotion.json
    elif [[ $args == *" base=main"* ]]; then
      # Security updates: Dependabot PRs into the base.
      file=$dir/security.json
    else
      file=$dir/open.json
    fi
    { cat "$file" 2>/dev/null || echo '[]'; } | jq '{data: {repository: {pullRequests: {nodes: [.[] | {
      number, body, headRefOid, mergeStateStatus, autoMergeRequest,
      author: (.author.login | if . == null then null
               elif startswith("app/") then {__typename: "Bot", login: ltrimstr("app/")}
               else {__typename: "User", login: .} end),
      commits: {nodes: [.commits[]? | {commit: {oid, messageBody, authors: {nodes: .authors}}}]},
      head: {nodes: [{commit: {statusCheckRollup:
        (if (.statusCheckRollup // []) == [] then null else {contexts: {nodes: .statusCheckRollup}} end)}}]}
    }]}}}}'
    ;;
  "pr list")
    if [[ $args == *statusCheckRollup* ]]; then
      echo "fake gh: --json statusCheckRollup needs Actions: read; use the script's own query" >&2
      exit 1
    elif [[ $args == *"--state merged"* ]]; then
      cat "$dir/merged.json"
    else
      echo "fake gh: unexpected call: gh $args" >&2
      exit 1
    fi
    ;;
  "pr view")
    cat "$dir/comments.json"
    ;;
  "pr merge" | "pr create" | "pr edit" | "pr comment")
    verb=$2
    echo "${args%% --body*}" >>"$dir/writes.log"
    while [[ $# -gt 0 ]]; do
      if [[ $1 == --body ]]; then
        printf '== %s\n%s\n' "${args%% --body*}" "$2" >>"$dir/bodies.log"
      fi
      shift
    done
    if [[ $verb == create ]]; then
      echo "https://github.com/example/repo/pull/31"
    fi
    ;;
  *)
    echo "fake gh: unexpected call: gh $args" >&2
    exit 1
    ;;
esac
